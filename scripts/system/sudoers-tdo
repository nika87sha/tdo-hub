# 🔐 SUDOERS - Reglas específicas para TDO Hub
# Plantilla: NO editar aquí. Generada dinámicamente por:
#   bash "$HUB_ROOT/scripts/system/install-sudoers.sh"
# Instala con: sudo visudo -f /etc/sudoers.d/tdo-hub
# ==========================================================

# Permitir a __USER__ ejecutar comandos específicos SIN contraseña
# Solo para focus_mode.sh: gestión de /etc/hosts y NetworkManager

# 1. Leer/escribir /etc/hosts (backup y restore)
__USER__ ALL=(root) NOPASSWD: /usr/bin/cp /etc/hosts __HUB_ROOT__/hosts.bak
__USER__ ALL=(root) NOPASSWD: /usr/bin/cp __HUB_ROOT__/hosts.bak /etc/hosts
__USER__ ALL=(root) NOPASSWD: /usr/bin/tee -a /etc/hosts

# 2. Reiniciar NetworkManager (para aplicar cambios de hosts)
__USER__ ALL=(root) NOPASSWD: /usr/bin/systemctl restart NetworkManager

# 3. Limpiar cache DNS (resolvectl)
__USER__ ALL=(root) NOPASSWD: /usr/bin/resolvectl flush-caches

# ==========================================================
# NOTA: Estas reglas son específicas y restrictivas.
# NO usar NOPASSWD: ALL ni comandos genéricos.
# ==========================================================